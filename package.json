{
  "name": "soma-tutor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm run db:start && concurrently --kill-others --names app,worker \"next dev\" \"npm run worker:dev\"",
    "dev:lan": "npm run db:start && npm run cert:lan && concurrently --kill-others --names app,worker \"next dev --hostname 0.0.0.0 --experimental-https --experimental-https-key .certificates/soma-local-key.pem --experimental-https-cert .certificates/soma-local.pem\" \"npm run worker:dev\"",
    "cert:lan": "node scripts/ensure-lan-certificate.mjs",
    "db:start": "prisma dev --detach",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently --kill-others --names app,worker \"next start\" \"npm run worker\"",
    "lint": "eslint",
    "worker": "tsx src/workers/generation.worker.ts",
    "worker:dev": "tsx watch src/workers/generation.worker.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0-snapshot.v20260810201553",
    "@github/copilot-sdk": "^1.0.10-preview.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1-canary.14",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "svix": "^2.0.0-rc.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1-canary.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
